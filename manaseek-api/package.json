    "@types/node": "^24.5.2",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "pino-pretty": "^13.1.1",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.4"
  }
