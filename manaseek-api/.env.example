# ---- Runtime ----
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
# Local: docker compose up -d
# Production: swap for the managed Postgres connection string (Neon, Supabase, RDS)
DATABASE_URL=postgresql://manaseek:manaseek@localhost:5432/manaseek?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Any OTP code accepted in development when set. NEVER enable outside development.
OTP_DEV_BYPASS_CODE=

# ---- Notification providers ----
# push: noop | fcm
PUSH_PROVIDER=noop
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# sms: noop | fonnte
SMS_PROVIDER=noop
FONNTE_TOKEN=

# ---- Booking ----
# Auto-expire pending booking requests after this many minutes
BOOKING_REQUEST_TTL_MINUTES=15
# Default search radius for nearby mutawif lookup
NEARBY_DEFAULT_RADIUS_KM=10
NEARBY_MAX_RADIUS_KM=50
