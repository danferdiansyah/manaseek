# ---- Runtime ----
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
# Local: docker compose up -d
# Production: swap for the managed Postgres connection string (Neon, Supabase, RDS)
DATABASE_URL=postgresql://manaseek:manaseek@localhost:5433/manaseek?schema=public

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Google Sign-In client ids allowed to call POST /auth/google.
# One per platform (web, Android, iOS), comma separated.
# Create them at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_IDS=

# Mints a session from an email address alone, for local development.
# The config validator refuses to start with this enabled in production.
AUTH_DEV_LOGIN=true

# ---- Notification providers ----
# push: noop | fcm
PUSH_PROVIDER=noop
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---- Booking ----
# Auto-expire pending booking requests after this many minutes
BOOKING_REQUEST_TTL_MINUTES=15
# Default search radius for nearby mutawif lookup
NEARBY_DEFAULT_RADIUS_KM=10
NEARBY_MAX_RADIUS_KM=50

# ---- Scheduling ----
# Set to false on serverless hosts, then call the internal task endpoint from
# the platform scheduler instead of relying on the in-process cron.
SCHEDULER_ENABLED=true
# Generate with: openssl rand -hex 24
INTERNAL_TASK_TOKEN=
