// Manaseek database schema.
//
// Ownership note: this file is shared by both engineering tracks, but models are
// grouped by owning module. Add models under the right section and never let a
// module read another module's tables directly at runtime.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection, used by the running app. On Supabase this is the
  // transaction pooler on port 6543 with ?pgbouncer=true.
  url       = env("DATABASE_URL")
  // Direct connection on port 5432. Migrations and introspection need it
  // because a transaction pooler cannot run them.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity (auth + users)
// ---------------------------------------------------------------------------

enum UserRole {
  JAMAAH
  MUTAWIF
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id String @id @default(uuid()) @db.Uuid

  /// Google account subject claim. The identity we authenticate against.
  googleId String? @unique
  email    String? @unique
  /// Contact number. Collected in the profile, not used to authenticate.
  phone    String? @unique

  name      String?
  avatarUrl String?
  role      UserRole   @default(JAMAAH)
  status    UserStatus @default(ACTIVE)

  // B2B hook. Kept nullable and relation-free until the partner module lands.
  organizationId String? @db.Uuid

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  jamaahProfile       JamaahProfile?
  mutawifProfile      MutawifProfile?
  refreshTokens       RefreshToken[]
  travelDocuments     TravelDocument[]
  trips               Trip[]
  deviceTokens        DeviceToken[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  jamaahBookings      Booking[]           @relation("JamaahBookings")
  reviewsWritten      Review[]            @relation("ReviewAuthor")
  checklistProgresses ChecklistProgress[]
  chatSessions        ChatSession[]

  @@index([role, status])
  @@index([organizationId])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  // Set when this token was rotated, pointing at its replacement. A reuse of a
  // rotated token is a strong signal of theft.
  replacedById String?   @db.Uuid
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum Gender {
  MALE
  FEMALE
}

enum MobilityNeed {
  NONE
  WHEELCHAIR
  WALKING_AID
  ELDERLY_ASSISTANCE
}

model JamaahProfile {
  id                    String       @id @default(uuid()) @db.Uuid
  userId                String       @unique @db.Uuid
  gender                Gender?
  birthDate             DateTime?    @db.Date
  address               String?
  city                  String?
  province              String?
  emergencyContactName  String?
  emergencyContactPhone String?
  mobilityNeed          MobilityNeed @default(NONE)
  medicalNotes          String?
  preferredLanguage     String       @default("id")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("jamaah_profiles")
}

enum TravelDocumentType {
  PASSPORT
  VISA
  ID_CARD
  VACCINE_CERTIFICATE
  OTHER
}

model TravelDocument {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  type      TravelDocumentType
  number    String?
  issuedAt  DateTime?          @db.Date
  expiresAt DateTime?          @db.Date
  fileUrl   String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("travel_documents")
}

enum TripType {
  HAJJ
  UMRAH
}

enum TripStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

model Trip {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @db.Uuid
  type          TripType
  packageName   String?
  agencyName    String?
  groupCode     String?
  departureDate DateTime   @db.Date
  returnDate    DateTime?  @db.Date
  status        TripStatus @default(UPCOMING)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("trips")
}

// ---------------------------------------------------------------------------
// Mutawif
// ---------------------------------------------------------------------------

enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum AvailabilityStatus {
  OFFLINE
  ONLINE
  BUSY
}

enum ServiceType {
  IBADAH_GUIDANCE
  MOBILITY_ASSISTANCE
  EMERGENCY
}

model MutawifProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  bio             String?
  languages       String[] @default([])
  yearsExperience Int      @default(0)
  city            String?

  verificationStatus VerificationStatus @default(DRAFT)
  verificationNote   String?
  submittedAt        DateTime?
  verifiedAt         DateTime?
  verifiedById       String?            @db.Uuid

  availabilityStatus AvailabilityStatus @default(OFFLINE)
  latitude           Float?
  longitude          Float?
  /// Radius of the reported fix in metres, so the jamaah-facing distance can
  /// be qualified rather than stated as fact.
  locationAccuracy   Float?
  locationUpdatedAt  DateTime?

  ratingAverage     Float @default(0)
  ratingCount       Int   @default(0)
  completedBookings Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents MutawifDocument[]
  rates     MutawifServiceRate[]
  slots     AvailabilitySlot[]
  bookings  Booking[]
  reviews   Review[]

  // Supports the bounding-box prefilter used by nearby search.
  @@index([latitude, longitude])
  @@index([verificationStatus, availabilityStatus])
  @@map("mutawif_profiles")
}

enum MutawifDocumentType {
  ID_CARD
  PASSPORT
  CERTIFICATE
  PORTRAIT
  CONTRACT
  OTHER
}

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model MutawifDocument {
  id        String               @id @default(uuid()) @db.Uuid
  mutawifId String               @db.Uuid
  type      MutawifDocumentType
  fileUrl   String
  status    DocumentReviewStatus @default(PENDING)
  note      String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  mutawif MutawifProfile @relation(fields: [mutawifId], references: [id], onDelete: Cascade)

  @@index([mutawifId, status])
  @@map("mutawif_documents")
}

model MutawifServiceRate {
  id          String      @id @default(uuid()) @db.Uuid
  mutawifId   String      @db.Uuid
  serviceType ServiceType
  hourlyRate  Decimal     @db.Decimal(12, 2)
  currency    String      @default("IDR")
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  mutawif MutawifProfile @relation(fields: [mutawifId], references: [id], onDelete: Cascade)

  @@unique([mutawifId, serviceType])
  @@map("mutawif_service_rates")
}

/// Weekly recurring availability window, stored in minutes from midnight in the
/// mutawif's local time (Asia/Riyadh).
model AvailabilitySlot {
  id          String @id @default(uuid()) @db.Uuid
  mutawifId   String @db.Uuid
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  startMinute Int
  endMinute   Int

  mutawif MutawifProfile @relation(fields: [mutawifId], references: [id], onDelete: Cascade)

  @@unique([mutawifId, dayOfWeek, startMinute])
  @@index([mutawifId, dayOfWeek])
  @@map("availability_slots")
}

// ---------------------------------------------------------------------------
// Booking
// ---------------------------------------------------------------------------

enum BookingStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  ONGOING
  COMPLETED
  CANCELLED
  EXPIRED
}

/// Payment is out of scope for the MVP; bookings settle offline. The field
/// exists so the payment module can be added later without a data migration.
enum PaymentStatus {
  UNPAID
  SETTLED_OFFLINE
  WAIVED
}

model Booking {
  id        String @id @default(uuid()) @db.Uuid
  code      String @unique
  jamaahId  String @db.Uuid
  mutawifId String @db.Uuid

  serviceType      ServiceType
  scheduledStartAt DateTime
  durationHours    Int
  hourlyRate       Decimal     @db.Decimal(12, 2)
  totalAmount      Decimal     @db.Decimal(12, 2)
  currency         String      @default("IDR")

  meetingPointLabel String
  meetingLatitude   Float?
  meetingLongitude  Float?
  notes             String?

  status        BookingStatus @default(REQUESTED)
  paymentStatus PaymentStatus @default(UNPAID)

  expiresAt     DateTime?
  acceptedAt    DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelledById String?   @db.Uuid
  cancelReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jamaah  User           @relation("JamaahBookings", fields: [jamaahId], references: [id])
  mutawif MutawifProfile @relation(fields: [mutawifId], references: [id])
  events  BookingEvent[]
  review  Review?

  @@index([jamaahId, status])
  @@index([mutawifId, status])
  @@index([status, expiresAt])
  @@index([mutawifId, scheduledStartAt])
  @@map("bookings")
}

model BookingEvent {
  id         String         @id @default(uuid()) @db.Uuid
  bookingId  String         @db.Uuid
  fromStatus BookingStatus?
  toStatus   BookingStatus
  actorId    String?        @db.Uuid
  actorRole  UserRole?
  reason     String?
  createdAt  DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @unique @db.Uuid
  jamaahId  String   @db.Uuid
  mutawifId String   @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  jamaah  User           @relation("ReviewAuthor", fields: [jamaahId], references: [id])
  mutawif MutawifProfile @relation(fields: [mutawifId], references: [id])

  @@index([mutawifId, createdAt])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Notification + audit
// ---------------------------------------------------------------------------

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

enum NotificationChannel {
  PUSH
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid
  channel     NotificationChannel
  templateKey String
  title       String?
  body        String
  data        Json?
  status      NotificationStatus  @default(PENDING)
  error       String?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Guidance content
//
// Ownership note: this section belongs to the content track. Everything seeded
// so far is DRAFT and must be reviewed by a qualified pembimbing before it is
// published to jamaah.
// ---------------------------------------------------------------------------

enum RitualPhase {
  PREPARATION
  IHRAM
  TAWAF
  SAI
  TAHALLUL
  WUKUF
  MABIT
  JUMRAH
  GENERAL
}

enum ContentCategory {
  UMRAH
  HAJJ
  DOA
  PERSIAPAN
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

model GuidanceTopic {
  id      String @id @default(uuid()) @db.Uuid
  slug    String @unique
  title   String
  summary String

  phase      RitualPhase
  categories ContentCategory[] @default([])
  /// Fiqh classification shown as a badge: Rukun, Wajib, Sunnah.
  obligation String?

  readingMinutes Int     @default(3)
  orderIndex     Int     @default(0)
  /// Lucide icon name the client maps to a component.
  icon           String?
  audioUrl       String?

  status     ContentStatus @default(DRAFT)
  reviewedBy String?
  reviewedAt DateTime?
  version    Int           @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps        GuidanceStep[]
  prayers      Prayer[]
  prohibitions Prohibition[]
  references   Reference[]

  @@index([status, phase, orderIndex])
  @@map("guidance_topics")
}

model GuidanceStep {
  id         String @id @default(uuid()) @db.Uuid
  topicId    String @db.Uuid
  orderIndex Int
  text       String

  topic GuidanceTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, orderIndex])
  @@map("guidance_steps")
}

model Prayer {
  id              String  @id @default(uuid()) @db.Uuid
  slug            String  @unique
  title           String
  arabic          String
  transliteration String
  translation     String
  /// Where the prayer is read, e.g. "Saat memasuki Masjidil Haram".
  context         String?
  orderIndex      Int     @default(0)

  topicId String?        @db.Uuid
  topic   GuidanceTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([topicId, orderIndex])
  @@map("prayers")
}

model Prohibition {
  id          String  @id @default(uuid()) @db.Uuid
  topicId     String  @db.Uuid
  orderIndex  Int
  text        String
  /// The fiqh consequence, e.g. "Wajib membayar dam".
  consequence String?

  topic GuidanceTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, orderIndex])
  @@map("prohibitions")
}

enum ReferenceKind {
  QURAN
  HADITH
  OTHER
}

/// Dalil for a topic. Curated, never generated: the assistant may quote what is
/// here and must refuse to invent anything that is not.
model Reference {
  id         String        @id @default(uuid()) @db.Uuid
  topicId    String        @db.Uuid
  orderIndex Int
  kind       ReferenceKind
  /// The reference itself, e.g. "QS. Al-Baqarah: 158".
  citation   String
  /// Short Indonesian gloss of what the reference says.
  gloss      String?
  /// Cleared by a reviewer once the wording and attribution are checked.
  verifiedAt DateTime?

  topic GuidanceTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, orderIndex])
  // "references" is a reserved word in Postgres; prefix it to keep raw SQL sane.
  @@map("guidance_references")
}

model ChecklistItem {
  id          String          @id @default(uuid()) @db.Uuid
  slug        String          @unique
  title       String
  description String?
  category    ContentCategory @default(PERSIAPAN)
  orderIndex  Int             @default(0)
  status      ContentStatus   @default(DRAFT)

  progress ChecklistProgress[]

  @@index([status, orderIndex])
  @@map("checklist_items")
}

/// One row per item a jamaah has ticked off. Absence means not done.
model ChecklistProgress {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  itemId      String   @db.Uuid
  completedAt DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@map("checklist_progress")
}

// ---------------------------------------------------------------------------
// Chatbot
//
// The assistant answers from the curated guidance library only. It is an
// information assistant, never a source of fatwa: anything that needs a ruling
// or physical help is handed to a human mutawif.
// ---------------------------------------------------------------------------

enum ChatRole {
  USER
  ASSISTANT
}

model ChatSession {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @db.Uuid
  /// First question, trimmed. Used as the label in the history list.
  title  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  role      ChatRole
  content   String

  /// Guidance topics the answer drew on, so the client can link to them.
  citedSlugs String[] @default([])
  /// Set when the assistant decided this needs a human mutawif.
  escalated  Boolean  @default(false)

  /// Kept per message so AI spend can be attributed without a separate ledger.
  promptTokens     Int?
  completionTokens Int?
  model            String?

  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}
