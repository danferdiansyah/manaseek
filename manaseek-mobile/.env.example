EXPO_PUBLIC_API_URL=https://manaseek-api.vercel.app/api
# Web/server OAuth client ID (the audience of the Google ID token).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional Google Cloud iOS client, only needed for an iOS build.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Development only; backend must also enable AUTH_DEV_LOGIN. Never enable in production.
EXPO_PUBLIC_DEV_LOGIN=false
# Optional absolute path or EAS file environment variable. Do not commit the file.
# GOOGLE_SERVICES_JSON=/absolute/path/google-services.json
