    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "tsx --test tests/*.test.ts",
    "export:android": "expo export --platform android",
    "check": "npm run typecheck && npm run lint && npm test && npm run export:android",
    "format": "prettier --write src tests scripts app.config.ts metro.config.js eslint.config.js",
    "test:preview": "node scripts/check-preview.mjs"
